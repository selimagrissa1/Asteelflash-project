<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body class="auth-body">

<div class="auth-card">
  <div class="auth-card__brand">
    <span class="topbar__icon">🌡️</span>
    <h1>Télémétrie CC1310</h1>
  </div>

  <h2 class="auth-card__title">Mot de passe oublié</h2>

  <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
    <div class="flash flash--success"><span>ℹ️</span><span><%= infoMessage %></span></div>
  <% } %>

  <% if (errors && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(err) { %><p><%= err %></p><% }); %>
    </div>
  <% } %>

  <% if (resetLink) { %>
    <div class="flash flash--success">
      <span>🔑</span>
      <span>
        Mode démo (pas de serveur d'e-mail configuré) : voici votre lien de réinitialisation —
        <a href="<%= resetLink %>"><%= resetLink %></a>
      </span>
    </div>
  <% } else { %>
    <form action="/forgot-password" method="POST" class="auth-form">
      <div class="form-field">
        <label for="email">Adresse e-mail associée à votre compte</label>
        <input type="email" id="email" name="email" required autofocus />
      </div>
      <button type="submit" class="btn">Envoyer le lien de réinitialisation</button>
    </form>
  <% } %>

  <p class="auth-switch"><a href="/login">Retour à la connexion</a></p>
</div>

</body>
</html>
