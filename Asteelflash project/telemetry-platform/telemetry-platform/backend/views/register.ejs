<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body class="auth-body">

<div class="auth-card">
  <div class="auth-card__brand">
    <span class="topbar__icon">🌡️</span>
    <h1>Télémétrie CC1310</h1>
  </div>

  <h2 class="auth-card__title">Créer un compte</h2>

  <%- include('partials/flash') %>

  <% if (errors && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(err) { %><p><%= err %></p><% }); %>
    </div>
  <% } %>

  <form action="/register" method="POST" class="auth-form">
    <div class="form-field">
      <label for="username">Nom d'utilisateur</label>
      <input type="text" id="username" name="username" value="<%= formData.username || '' %>" required autofocus />
    </div>
    <div class="form-field">
      <label for="email">Adresse e-mail</label>
      <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required />
    </div>
    <div class="form-field">
      <label for="password">Mot de passe</label>
      <input type="password" id="password" name="password" required />
      <span class="form-hint">Au moins 8 caractères, une lettre et un chiffre.</span>
    </div>
    <div class="form-field">
      <label for="confirmPassword">Confirmer le mot de passe</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required />
    </div>

    <button type="submit" class="btn">Créer mon compte</button>
  </form>

  <p class="auth-switch">Déjà un compte ? <a href="/login">Se connecter</a></p>
</div>

</body>
</html>
