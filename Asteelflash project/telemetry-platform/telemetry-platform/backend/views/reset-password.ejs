<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head') %>
</head>
<body class="auth-body">

<div class="auth-card">
  <div class="auth-card__brand">
    <span class="topbar__icon">🌡️</span>
    <h1>Télémétrie CC1310</h1>
  </div>

  <h2 class="auth-card__title">Nouveau mot de passe</h2>

  <% if (errors && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(err) { %><p><%= err %></p><% }); %>
    </div>
  <% } %>

  <form action="/reset-password/<%= token %>" method="POST" class="auth-form">
    <div class="form-field">
      <label for="password">Nouveau mot de passe</label>
      <input type="password" id="password" name="password" required autofocus />
      <span class="form-hint">Au moins 8 caractères, une lettre et un chiffre.</span>
    </div>
    <div class="form-field">
      <label for="confirmPassword">Confirmer le mot de passe</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required />
    </div>
    <button type="submit" class="btn">Réinitialiser le mot de passe</button>
  </form>
</div>

</body>
</html>
